{
  "name": "motion-arcade",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "https:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/setup-lan-https.ps1",
    "dev:https": "vite --config vite.https.config.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.18",
    "lucide": "^0.468.0",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.10.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@11.9.0"
}
